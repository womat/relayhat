# systemd unit for relayhat.
#
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin relayhat
#   sudo usermod -aG gpio relayhat
#   sudo install -d -o root -g root -m 0755 /opt/relayhat /opt/relayhat/bin
#   sudo install -d -o root -g relayhat -m 0750 /opt/relayhat/etc
#   sudo install -d -o relayhat -g relayhat -m 0750 /opt/relayhat/data
#   sudo install -o root -g root -m 0755 relayhat /opt/relayhat/bin/relayhat
#   sudo install -o root -g relayhat -m 0640 config/config.yaml /opt/relayhat/etc/config.yaml
#   sudo cp contrib/relayhat.service /etc/systemd/system/
#   sudo /opt/relayhat/bin/relayhat token add browser
#   sudo systemctl enable --now relayhat
#
# Everything under /opt/relayhat belongs to root except data/, where relayhat keeps the
# relay states; the group relayhat may only read etc/. Whoever can write config.yaml or the
# token file can add a token of their own, and whoever can write bin/relayhat can replace
# the program. key.pem goes in as root:relayhat 0640, cert.pem as 0644.
#
# "systemctl reload relayhat" rereads config.yaml and the token file. A config that does
# not load or validate ends relayhat with exit code 78, and RestartPreventExitStatus
# keeps systemd from restarting it until the file is fixed: "systemctl status relayhat"
# shows why.
#
# The sandbox: relayhat needs the network (HTTPS), the GPIO character device and
# write access to data/, nothing else. A logDestination file must lie in data/ as well.
# "systemd-analyze security relayhat" rates the result.

[Unit]
Description=relayhat - relays of a BC Robotics Relay HAT over HTTPS
Documentation=https://github.com/womat/relayhat
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=relayhat
Group=relayhat
ExecStart=/opt/relayhat/bin/relayhat
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=/opt/relayhat/data
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
UMask=0077
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
# Only the GPIO chip; PrivateDevices=yes would hide it.
DevicePolicy=closed
DeviceAllow=/dev/gpiochip0 rw

[Install]
WantedBy=multi-user.target
